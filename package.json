{
  "name": "gothere",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A lighthearted, data-driven puzzle about getting there, no matter what",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "cli": "node dist/gothere-cli.mjs",
    "precli": "node scripts/build-cli.mjs --quiet",
    "cli:src": "node bin/gothere.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "build:agent": "node scripts/build-skill.mjs",
    "check:skill": "node scripts/build-skill.mjs --check",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:bin": "node scripts/build-binary.mjs",
    "css": "node scripts/css.mjs",
    "css:watch": "node scripts/css.mjs --watch",
    "build": "node scripts/build.mjs && node scripts/build-cli.mjs",
    "start": "node server.mjs",
    "share": "node scripts/share.mjs",
    "check:layers": "node scripts/check-layers.mjs",
    "pretest": "node scripts/css.mjs",
    "test": "node --test tests/*.test.mjs",
    "pretest:coverage": "node scripts/css.mjs",
    "test:coverage": "node --experimental-test-coverage --test --test-coverage-include=src/core/*.js --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 tests/*.test.mjs",
    "test:e2e": "node scripts/browser-check.mjs",
    "test:share": "node scripts/check-shared.mjs",
    "prepare": "node scripts/build-cli.mjs && node scripts/css.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^45.0.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3"
  },
  "bin": {
    "gothere": "dist/gothere-cli.mjs"
  },
  "files": [
    "dist/gothere-cli.mjs",
    "dist/gothere-cli.cjs",
    "README.md"
  ]
}
