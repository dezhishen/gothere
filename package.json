{
  "name": "gothere",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A lighthearted, data-driven puzzle about getting there, no matter what",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "css": "node scripts/css.mjs",
    "css:watch": "node scripts/css.mjs --watch",
    "build": "node scripts/build.mjs",
    "start": "node server.mjs",
    "share": "node scripts/share.mjs",
    "pretest": "node scripts/css.mjs",
    "test": "node --test tests/*.test.mjs",
    "pretest:coverage": "node scripts/css.mjs",
    "test:coverage": "node --experimental-test-coverage --test --test-coverage-include=src/core/*.js --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 tests/*.test.mjs",
    "test:e2e": "node scripts/browser-check.mjs",
    "test:share": "node scripts/check-shared.mjs",
    "prepare": "node scripts/css.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3"
  }
}
