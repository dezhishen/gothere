{
  "schemaVersion": 1,
  "id": "just-in-time",
  "name": "赶个巧",
  "description": "桥有时限，风也不客气。别急着全点，轮到谁再安排谁。",
  "hint": "木桥会在 5 秒后收起：在他接近缺口时再拨开关。过桥后，靠近风扇再让它停下。压力板会打开最后的门。",
  "world": {
    "width": 1200,
    "height": 640,
    "groundY": 440
  },
  "actor": {
    "x": 95,
    "speed": 68
  },
  "goal": {
    "x": 1100
  },
  "platforms": [
    {
      "x": 0,
      "width": 390
    },
    {
      "x": 560,
      "width": 640
    }
  ],
  "entities": [
    {
      "id": "bridge",
      "kind": "bridge",
      "x": 390,
      "width": 170,
      "state": "folded",
      "label": "限时木桥"
    },
    {
      "id": "lever",
      "kind": "switch",
      "x": 290,
      "width": 28,
      "state": "off",
      "label": "限时桥开关"
    },
    {
      "id": "fan",
      "kind": "hazard",
      "x": 755,
      "width": 58,
      "state": "running",
      "label": "旧风扇"
    },
    {
      "id": "plate",
      "kind": "plate",
      "x": 895,
      "width": 44,
      "state": "idle",
      "label": "门前压力板"
    },
    {
      "id": "gate",
      "kind": "gate",
      "x": 1000,
      "width": 24,
      "state": "closed",
      "label": "花园小门"
    }
  ],
  "rules": [
    {
      "on": {
        "type": "click",
        "source": "lever"
      },
      "actions": [
        {
          "type": "set",
          "target": "lever",
          "state": "on"
        },
        {
          "type": "set",
          "target": "bridge",
          "state": "extended"
        },
        {
          "type": "after",
          "ticks": 300,
          "actions": [
            {
              "type": "set",
              "target": "bridge",
              "state": "folded"
            },
            {
              "type": "set",
              "target": "lever",
              "state": "off"
            }
          ]
        }
      ]
    },
    {
      "on": {
        "type": "click",
        "source": "fan"
      },
      "actions": [
        {
          "type": "set",
          "target": "fan",
          "state": "stopped"
        },
        {
          "type": "after",
          "ticks": 240,
          "actions": [
            {
              "type": "set",
              "target": "fan",
              "state": "running"
            }
          ]
        }
      ]
    },
    {
      "on": {
        "type": "enter",
        "source": "plate"
      },
      "actions": [
        {
          "type": "set",
          "target": "gate",
          "state": "open"
        }
      ]
    }
  ]
}
